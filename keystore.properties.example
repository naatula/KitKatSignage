# Copy this file to keystore.properties (gitignored) and point it at your own
# release signing key. Generate one with:
#
#   keytool -genkeypair -v -keystore release.keystore.jks \
#       -alias kitkatsignage -keyalg RSA -keysize 2048 -validity 10000
#
# Keep both this file and the keystore off version control: losing the key
# means every display has to be uninstalled before it can be updated again.
storeFile=release.keystore.jks
storePassword=CHANGE_ME
keyAlias=kitkatsignage
keyPassword=CHANGE_ME
